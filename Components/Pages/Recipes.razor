@page "/recipes"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations

<PageTitle>Recipes</PageTitle>
<form @onsubmit:preventDefault="true" @onsubmit="Submit">
    <input @bind="searchModel.Query"
                       class="w-[600px] mx-auto block px-3 py-2 border-2 !border-gray-200 rounded-full bg-white shadow-sm focus:ring-2 focus:ring-green-500 focus:!border-green-500 text-gray-900 placeholder-gray-400 transition-all duration-200 focus:outline-none"
                       placeholder="Czego szukasz?" />
</form>


<SearchResults searchModel="@searchModel" />

@code {
    protected SearchModel searchModel = new();

    protected override void OnInitialized() {
        searchModel.Limit = true;
    }

    private void Submit()
    {
        Console.WriteLine(searchModel.Query);
        StateHasChanged();
    }
}
