@page "/test"
@rendermode InteractiveServer

<h3 style="color: red;">TEST KOMPONENTU</h3>

<button @onclick="TestClick"
        style="background: red; color: white; padding: 20px; font-size: 30px;">
    KLIKNIJ MNIE
</button>

<p style="font-size: 24px; color: blue;">@message</p>

@code {
    private string message = "NIE KLIKNIĘTO";

    private void TestClick()
    {
        message = "DZIAŁA! " + DateTime.Now.ToString("HH:mm:ss.fff");
    }
}
